{
    "name": "fiammybe/immcpprovider",
    "description": "MCP (Model Context Protocol) provider module for ImpressCMS 2",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "league/oauth2-server": "^9.4",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "ImMcpProvider\\OAuth\\": "OAuthServer/",
            "ImMcpProvider\\": "."
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
